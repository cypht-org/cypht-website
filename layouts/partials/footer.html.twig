                },
            ]
        },
        {
            title: 'support',
            childrens: [
                {
                    'title': 'FAQ',
                    'href': '/#faq'
                },
                {
                    'title': 'Community',
                    'href': 'https://matrix.to/#/#cypht-org_community:gitter.im',
                    'external': true
                },
                {
                    'title': 'Event',
                    'href': '/events'
                }
            ]
        }
    ],
    policies: [
        {
            title: 'License',
            href: 'https://github.com/cypht-org/cypht/blob/master/LICENSE',
            external: true
        },
        {
            title: 'Releases',
            href: 'https://github.com/cypht-org/cypht/releases',
