                },
                {
                    'title': 'Performance',
                    'href': '/features#performance'
                },
                {
                    'title': 'Search',
                    'href': '/features#search'
                },
                {
                    'title': 'Development',
                    'href': '/features#development'
                }
            ]
        },
        {
            title: 'resources',
            childrens: [
                {
                    'title': 'Install',
                    'href': '/install'

                },
                {
                    'title': 'User Guide',
                    'href': '/documentation'
                },
                {
                    'title': 'Tiki Webmail',
                    'href': '/tiki-webmail',
                    'external': true
                }
            ]
        },
        {
            title: 'about',
            childrens: [
                {
                    'title': 'License',
                    'href': '/license'
                },
                {
                    'title': 'Contribute',
                    'href': '/contribute'
                },
                 {
