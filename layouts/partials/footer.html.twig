<footer class="footer-content">
  <!-- Main footer section -->
  <div class="footer-main">
    <div class="footer-container mb-2">
      <!-- Branding and newsletter -->
      <div class="footer-brand">
        <div class="d-flex flex-column brand-header">
          <div class="logo-wrapper">
            <img
              id="footer_logo"
              src="/img/logo_dark.svg"
              alt="Cypht"
              width="140"
              height="62"
              loading="lazy"
              decoding="async"
              class="footer-logo"
            />
          </div>
          <p class="brand-description">
            Secure, Open Source email client for all your communication needs.
          </p>
        </div>

        <div class="social-links">
          {% for social in footer_links.socials %}
            <a href="{{ social.href }}" class="social-link" target="_blank" rel="noopener" aria-label="{{ social.title }}" title="{{ social.title }}">
              <i class="{{ social.icon }}" aria-hidden="true"></i>
            </a>
          {% endfor %}
        </div>
      </div>

      <!-- Organized links -->
      <div class="footer-links flex-1">
        {% for link in footer_links.links %}
          <div class="link-column">
            <h4 class="link-title text-capitalize">{{ link.title }}</h4>
            {% for children in link.childrens %}
              <a href="{{ children.href }}" class="link-item"{% if children.external|default(false) %} target="_blank" rel="noopener"{% endif %}>{{ children.title }}</a>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Footer bottom -->
  <div class="footer-bottom cy-container">
    <div class="footer-container">
      <div class="footer-bottom-content">
        <p class="copyright">
          ©
          {{ 'now'|date('Y') }}
          Cypht.org. All rights reserved.
        </p>
        <div class="policies-links">
          {% for link in footer_links.policies %}
            <a href="{{ link.href }}" target="{{ link.external ? '_blank' : '' }}" rel="noopener">{{ link.title }}</a>
          {% endfor %}
        </div>
      </div>
      {# <span class="text-center d-flex justify-content-center footer-label">Cypht</span> #}
    </div>
  </div>
</footer>
