        }
    ],
    socials: [
        {
            title: 'X',
            icon: 'bi bi-twitter-x',
            href: 'https://x.com/CyphtWebmail',
            external: true
        },
        {
            title: 'LinkedIn',
            icon: 'bi bi-linkedin',
            href: 'https://www.linkedin.com/groups/13804559',
            external: true
        },
        {
            title: 'GitHub',
            icon: 'bi bi-github',
            href: 'https://github.com/cypht-org/cypht',
            external: true
        },
        {
