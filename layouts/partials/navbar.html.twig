{# Menu list #}
{% set global_menus = {
    main: [
        { 
            title: 'Home', 
            href: '/', 
            icon: 'bi-house',
		svg: null,
            description: 'Home page'
        },
        { 
            title: 'Features', 
            href: '/features', 
            icon: 'bi-star',
		svg: null,
            description: 'Main features'
        },
        { 
            title: 'Security', 
            href: '/security', 
            icon: 'bi-shield-check',
		svg: null,
            description: 'Security and protection'
        }
    ],
    tools: [
        { 
            title: 'Modules', 
            href: '/modules', 
            icon: 'bi-puzzle',
		svg: '/svg/puzzle.svg',
            description: 'Modules management'
        },
        { 
            title: 'Config Generator', 
            href: '/config-generator', 
            icon: 'bi-gear',
		svg: '/svg/settings.svg',
            description: 'Configuration generator'
        },
        { 
            title: 'Installation', 
            href: '/install', 
            icon: 'bi-download',
		svg: '/svg/install.svg',
            description: 'Installation guide'
        }
    ],
    docs: [
        { 
            title: 'App Doc', 
            href: '/documentation', 
            icon: 'bi-file-earmark-text',
		svg: '/svg/doc.svg',
            description: 'Application documentation'
        },
        { 
            title: 'License', 
            href: '/license', 
            icon: 'bi-file-earmark-check',
		svg: '/svg/plugin.svg',
            description: 'License information'
        },
        { 
            title: 'Contributor', 
            href: '/contribute', 
            icon: 'bi-people',
		svg: '/svg/contributor.svg',
            description: 'How to contribute to the project'
        },
	  { 
            title: 'Events', 
            href: '/events', 
            icon: 'bi-calendar',
		svg: '/svg/event.svg',
            description: 'Events and updates'
        }
    ],
    integration: [
        { 
            title: 'Cypht in Tiki', 
            href: '/tiki-webmail', 
            icon: 'bi-file-earmark-text',
		svg: null,
            description: 'For more cypht features'
        }
    ]
} %}

{# Template #}
<nav class="pt-lg-3 pb-1 " id="mainNavbar">
	<div
		class="nav-container">
		<!-- Logo Section -->
		<div class="nav-brand">
			<a href="/" class="">
				<div class="logo-wrapper">
					<img src="/img/logo.svg" alt="Cypht" class="logo-img ">
				</div>
			</a>
		</div>

		<!-- Desktop Navigation -->
		<div class="d-none d-lg-flex desktop-nav flex-1 ms-4 justify-content-between gap-4">
			<div class="nav-menu desktop-nav flex-1 ">
				<div class="nav-links w-100">
					{% for item in global_menus.main %}
						{% set is_active = false %}
						{% if item.href == '/' %}
							{% if page.path == 'index' or page.path == '/' or page.path == '' %}
								{% set is_active = true %}
							{% endif %}
						{% elseif item.href != '/' and page.path is defined and page.path != '' and (page.path == item.href|trim('/') or page.path starts with item.href|trim('/')) %}
							{% set is_active = true %}
						{% endif %}
						<a href="{{ item.href }}" class="nav-item {{ is_active ? 'active' : '' }}" {{ is_active ? 'aria-current="page"' : '' }}>
							<span class="nav-text">{{ item.title }}</span>
						</a>
					{% endfor %}

					<!-- Tools Dropdown -->
					{% set tools_active = false %}
					{% for item in global_menus.tools %}
						{% if item.href != '/' and page.path is defined and page.path != '' and page.path starts with item.href|trim('/') %}
							{% set tools_active = true %}
						{% endif %}
					{% endfor %}
					<div class="nav-dropdown {{ tools_active ? 'active' : '' }}" data-dropdown="tools">
						<button class="nav-item dropdown-trigger {{ tools_active ? 'active' : '' }}" data-trigger="tools">
							<span class="nav-text">Tools</span>
							<i class="bi bi-chevron-down dropdown-arrow"></i>
						</button>
						<div class="dropdown-panel" data-panel="tools">
							<div class="dropdown-content">
								{% for item in global_menus.tools %}
									<a href="{{ item.href }}" class="dropdown-item d-flex  gap-2">
										<div class="drop-item-icon">
											{% if item.svg %}
												<img src="{{ item.svg }}" alt="{{ item.title }}">
											{% else %}
												<i class="{{ item.icon }}"></i>
											{% endif %}
										</div>
										<div class="drop-item-content mt-1">
											<span class="drop-item-title">{{ item.title }}</span>
											<span class="drop-item-description">{{ item.description }}</span>
										</div>
									</a>
								{% endfor %}
							</div>
						</div>
					</div>

					<!-- Documentation Dropdown -->
					{% set docs_active = false %}
					{% for item in global_menus.docs %}
						{% if item.href != '/' and page.path is defined and page.path != '' and page.path starts with item.href|trim('/') %}
							{% set docs_active = true %}
						{% endif %}
					{% endfor %}
					<div class="nav-dropdown {{ docs_active ? 'active' : '' }}" data-dropdown="docs">
						<button class="nav-item dropdown-trigger {{ docs_active ? 'active' : '' }}" data-trigger="docs">
							<span class="nav-text">Documentation</span>
							<i class="bi bi-chevron-down dropdown-arrow"></i>
						</button>
						<div class="dropdown-panel" data-panel="docs">
							<div class="dropdown-content">
								{% for item in global_menus.docs %}
									<a href="{{ item.href }}" class="dropdown-item d-flex gap-2">
										<div class="drop-item-icon">
											{% if item.svg %}
												<img src="{{ item.svg }}" alt="{{ item.title }}">
											{% else %}
												<i class="{{ item.icon }}"></i>
											{% endif %}
										</div>
										<div class="drop-item-content mt-1">
											<span class="drop-item-title">{{ item.title }}</span>
											<span class="drop-item-description">{{ item.description }}</span>
										</div>
									</a>
								{% endfor %}
							</div>
						</div>
					</div>
					{# Integration Dropdown #}
					{% set integration_active = false %}
					{% for item in global_menus.integration %}
						{% if item.href != '/' and page.path is defined and page.path != '' and page.path starts with item.href|trim('/') %}
							{% set integration_active = true %}
						{% endif %}
					{% endfor %}
					<div class="nav-dropdown {{ integration_active ? 'active' : '' }}" data-dropdown="integration">
						<button class="nav-item dropdown-trigger {{ integration_active ? 'active' : '' }}" data-trigger="integration">
							<span class="nav-text">Integration</span>
							<i class="bi bi-chevron-down dropdown-arrow"></i>
						</button>
						<div class="dropdown-panel" data-panel="integration">
							<div class="dropdown-content">
								{% for item in global_menus.integration %}
									<a href="{{ item.href }}" class="dropdown-item d-flex gap-2">
										<div class="drop-item-icon">
											<img src="/img/tiki_logo.png" alt="{{ item.title }}">
										</div>
										<div class="drop-item-content mt-1">
											<span class="drop-item-title">{{ item.title }}</span>
											<span class="drop-item-description">{{ item.description }}</span>
										</div>
									</a>
								{% endfor %}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Mobile Toggle Button -->
		<div class="mobile-actions-container d-flex justify-content-between align-items-center gap-3">

			<div class="mobile-actions d-none d-md-flex align-items-center justify-content-center gap-3">
				<a href="https://github.com/cypht-org/cypht" target="_blank" rel="noopener" class="action-btn github-btn" title="View on GitHub">
					<i class="bi bi-github"></i>
					<span class="btn-text d-flex d-lg-none d-xl-flex">GitHub</span>
				</a>

				<button id="theme-toggle" class="action-btn theme-toggle" aria-label="Toggle dark mode" title="Change theme">
					<i id="theme-icon" class="bi bi-moon"></i>
				</button>
			</div>

			<button class="mobile-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavOffcanvas" aria-controls="mobileNavOffcanvas" aria-label="Toggle navigation menu" aria-expanded="false">
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Solar by 480 Design - https://creativecommons.org/licenses/by/4.0/ --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" d="M4 7h3m13 0h-9m9 10h-3M4 17h9m-9-5h16"/></svg>
			</button>

		</div>

		<!-- Mobile Navigation Offcanvas -->
		<div class="offcanvas offcanvas-end px-1" tabindex="-1" id="mobileNavOffcanvas" aria-labelledby="mobileNavOffcanvasLabel">
			<div class="offcanvas-header">
				<div class="logo-wrapper">
					<img src="/img/logo.svg" alt="Cypht" class="logo-img ">
				</div>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
			</div>
			<div class="offcanvas-body">
				<div
					class="mobile-links">
					{# Mobile primary menu #}
					{% for item in global_menus.main %}
						{% set current = (item.href == '/' and page.path == 'index') or (item.href != '/' and page.path starts with item.href|trim('/')) %}
						<a href="{{ item.href }}" class="mobile-nav-item {{ current ? 'active' : '' }}">
							{{ item.title }}
						</a>
					{% endfor %}

					{# Accordion used for dropdown sections #}
					<div
						class="accordion accordion-flush mobile-accordion" id="mobileNavAccordion">
						{# Tools Dropdown #}
						<div class="accordion-item">
							<h2 class="accordion-header">
								<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTools" aria-expanded="false" aria-controls="collapseTools">
									Tools
								</button>
							</h2>
							<div id="collapseTools" class="accordion-collapse collapse" data-bs-parent="#mobileNavAccordion">
								<div class="accordion-body">
									{% for item in global_menus.tools %}
										<a href="{{ item.href }}" class="mobile-nav-item mobile-nav-subitem">
											{{ item.title }}
										</a>
									{% endfor %}
								</div>
							</div>
						</div>

						{# Documentation Dropdown #}
						<div class="accordion-item">
							<h2 class="accordion-header">
								<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDocs" aria-expanded="false" aria-controls="collapseDocs">
									Documentation
								</button>
							</h2>
							<div id="collapseDocs" class="accordion-collapse collapse" data-bs-parent="#mobileNavAccordion">
								<div class="accordion-body">
									{% for item in global_menus.docs %}
										<a href="{{ item.href }}" class="mobile-nav-item mobile-nav-subitem">
											{{ item.title }}
										</a>
									{% endfor %}
								</div>
							</div>
						</div>

						{# Integration Dropdown #}
						<div class="accordion-item">
							<h2 class="accordion-header">
								<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseIntegration" aria-expanded="false" aria-controls="collapseIntegration">
									Integration
								</button>
							</h2>
							<div id="collapseIntegration" class="accordion-collapse collapse" data-bs-parent="#mobileNavAccordion">
								<div class="accordion-body">
									{% for item in global_menus.integration %}
										<a href="{{ item.href }}" class="mobile-nav-item mobile-nav-subitem">
											{{ item.title }}
										</a>
									{% endfor %}
								</div>
							</div>
						</div>
					</div>
				</div>
				{# Offcanvas footer #}
				<div class="offcanvas-footer">
					<div class="offcanvas-actions mb-2 gap-3">
						<a href="https://github.com/cypht-org/cypht" target="_blank" rel="noopener" class="action-btn github-btn" title="View on GitHub">
							<i class="bi bi-github"></i>
							<span class="btn-text">GitHub</span>
						</a>
						<button class="action-btn theme-toggle" aria-label="Toggle dark mode" title="Change theme">
							<i class="theme-icon bi bi-moon"></i>
						</button>
					</div>
					<div class="footer-content">
						<p class="footer-text">
							<span class="footer-text-bold">Cypht</span>
							is a free and open-source project.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</nav>
