{# Template #}
<section>
	<div class="config-gen-container">
		<div class="config-content">
			<div class="config-left">
				<nav>
					<div class="config-left-header">
						<h5>Config menu</h5>
						<p>Choose a config to generate</p>
					</div>
					<ul class="config-generator-list">
						{% for item in confg_menu %}
							<li class="position-relative">
								<a href="{{item.href}}" class="config-generator-link text-capitalize {{item.id == 0 ? 'config-active' : ''}}" data-id="{{item.id}}">{{item.title}}</a>
							</li>
						{% endfor %}
					</ul>
					<div class="config-left-footer">
						<button class="btn btn-primary">Preview your config</button>
					</div>
				</nav>
			</div>
			<div
				class="config-right">
				{# App config #}
				<div class="config-content-item">
					<div class="config-content-item-header">
						<h5>App Config</h5>
						<p>Generate your app config</p>
					</div>
					<div class="config-content-item-body"></div>
					<div class="config-content-item-footer">
						<button class="btn btn-primary">Generate Config</button>
					</div>
				</div>
				{# Database config #}
				<div class="config-content-item">
					<div class="config-content-item-header">
						<h5>Database Config</h5>
						<p>Generate your database config</p>
					</div>
					<div class="config-content-item-body"></div>
					<div class="config-content-item-footer">
						<button class="btn btn-primary">Generate Config</button>
					</div>
				</div>
				{# 2FA config #}
				<div class="config-content-item">
					<div class="config-content-item-header">
						<h5>2FA Config</h5>
						<p>Generate your 2FA config</p>
					</div>
					<div class="config-content-item-body"></div>
					<div class="config-content-item-footer">
						<button class="btn btn-primary">Generate Config</button>
					</div>
				</div>
				{# Dynamic login config #}
				<div class="config-content-item">
					<div class="config-content-item-header">
