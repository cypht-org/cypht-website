{# Template #}
<section>
	<div
		class="">
		{# Floating btn #}
		<div class="floating-btn-container w-100 d-flex d-xl-none">
			<div class="floating-btn-content position-relative">
				<button type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">
					<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.061 20.045C6.375 21 8.251 21 12 21s5.625 0 6.939-.955a5 5 0 0 0 1.106-1.106C21 17.625 21 15.749 21 12s0-5.625-.955-6.939a5 5 0 0 0-1.106-1.106C17.625 3 15.749 3 12 3s-5.625 0-6.939.955A5 5 0 0 0 3.955 5.06C3 6.375 3 8.251 3 12s0 5.625.955 6.939a5 5 0 0 0 1.106 1.106M17 18l1-1m-5 1l5-5m-9 5l9-9"/></svg>
				</button>
			</div>
		</div>
		<div class="config-gen-container">
			<div class="config-content row">
				<div class="config-left d-none d-md-block col-md-3 col-xl-2">
					<nav>
						<div class="config-left-header">
							<div class="">
								<h6>Config menu</h6>
								<p>Choose a config to generate</p>
								{# <div class="d-flex gap-2 align-items-center cfh-version">
																																																																																																																																																																																																																																																																																																																																																																																																																																																																	<span class="version-label">Vesion</span>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																	<div class="custom-select">
																																																																																																																																																																																																																																																																																																																																																																																																																																																																		<button class="select-btn">
																																																																																																																																																																																																																																																																																																																																																																																																																																																																			<span id="selected_text" class="selected-text"></span>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																			<span class="arrow">
																																																																																																																																																																																																																																																																																																																																																																																																																																																																				<i class="bi bi-chevron-down dropdown-arrow"></i>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																			</span>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																		</button>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																		<ul class="select-menu">
																																																																																																																																																																																																																																																																																																																																																																																																																																																																			<li data-value="Version 1.0.1">V1.x</li>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																			<li data-value="Version 1.0.1">V2.x</li>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																		</ul>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																	</div>
																																																																																																																																																																																																																																																																																																																																																																																																																																																																</div> #}
							</div>


						</div>
						<div class="config-generator-list-container pb-5">
							<ul class="config-generator-list ms-1">
								{% for item in config_menu %}

									{% if item.children is defined and item.children|length > 1 %}
										<li class="position-relative cg-menu-group">
											<span href=" {{item.href}} " class=" text-capitalize cg-menu-group-title" data-id=" {{item.id}} ">{{item.title}}
											</span>
											<div class="position-relative">
												<div class="cc-line-top"></div>
												<ul class="group-list">
													{% for child in item.children %}
														<li class="position-relative">
															<a href="{{child.href}}" data-id="{{child.id}}">{{child.title}}</a>
														</li>
													{% endfor %}
												</ul>
												<div class="cc-line-bottom"></div>
											</div>
										</li>
									{% else %}
										<li class="position-relative cg-menu-alone">
											<a href="{{item.href}}" class="config-generator-link text-capitalize" data-id="{{item.id}}">{{item.title}}</a>
										</li>
									{% endif %}
								{% endfor %}
							</ul>
						</div>
					</nav>
				</div>
				<div
					id="app_config" class="config-center col">
					{# App config #}
					<div class="config-content-item">
						<div class="config-content-item-header">
							<div class="cc-item-top">
								<div class="cc-item-top-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24">
										<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M7 21h10"/><rect width="20" height="14" x="2" y="3" rx="2"/></g>
									</svg>
								</div>
								<div class="cc-item-top-text">
									<h5>App Config</h5>
									<p>Configure your Cypht application's core settings. Customize the basic behavior, display preferences, and essential features for an optimal user experience.</p>
								</div>
							</div>
						</div>
						<!-- Section General -->
						<div class="config-content-item" id="general">
							<div class="cc-body-header">
								<div class="cc-body-header-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.513 19.487c2.512 2.392 5.503 1.435 6.7.466c.618-.501.897-.825 1.136-1.065c.837-.777.784-1.555.24-2.177c-.219-.249-1.616-1.591-2.956-2.967c-.694-.694-1.172-1.184-1.582-1.58c-.547-.546-1.026-1.172-1.744-1.154c-.658 0-1.136.58-1.735 1.179c-.688.688-1.196 1.555-1.375 2.333c-.539 2.273.299 3.888 1.316 4.965m0 0L2 21.999M19.487 4.515c-2.513-2.394-5.494-1.42-6.69-.45c-.62.502-.898.826-1.138 1.066c-.837.778-.784 1.556-.239 2.178c.078.09.31.32.635.644m7.432-3.438c1.017 1.077 1.866 2.71 1.327 4.985c-.18.778-.688 1.645-1.376 2.334c-.598.598-1.077 1.179-1.735 1.179c-.718.018-1.09-.502-1.639-1.048m3.423-7.45L22 2m-5.936 9.964c-.41-.395-.994-.993-1.688-1.687c-.858-.882-1.74-1.75-2.321-2.325m4.009 4.012l-1.562 1.524m-3.99-3.983l1.543-1.553" color="currentColor"/></svg>
									<span>General Settings</span>
								</div>
								<button type="button" class="cc-header-reset-btn" onclick="resetSection('general')">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.001 10c0 3.3 0 4.95 1.025 5.975S5.701 17 9.001 17s4.95 0 5.975-1.025S16 13.3 16 10s0-4.95-1.025-5.975S12.3 3 9 3S4.05 3 3.025 4.025S2.001 6.7 2.001 10M22 14.42l-1.11-1.346c-.591-.716-.887-1.074-1.254-1.074v1c0 3.771 0 5.657-1.171 6.828S15.408 21 11.636 21H11" color="currentColor"/></svg>
									Reset
								</button>
							</div>
							<div class="cc-body-content">
								<div class="form-field">
									<label for="app_name" class="form-field-label">Application Name</label>
									<input type="text" name="APP_NAME" id="app_name" class="form-input" placeholder="Cypht" value="Cypht">
									<div class="form-field-description">Name of your application</div>
								</div>
								<div class="form-field">
									<label for="admin_users" class="form-field-label">Admin Users</label>
									<input type="text" name="ADMIN_USERS" id="admin_users" class="form-input" placeholder="admin@example.com">
									<div class="form-field-description">Comma-separated list of admin user emails</div>
								</div>
								<div class="form-field">
									<label for="default_language" class="form-field-label">Default Language</label>
									<input type="text" name="DEFAULT_LANGUAGE" id="default_language" class="form-input" placeholder="en" value="en">
									<div class="form-field-description">Default language code (e.g., en, fr, de)</div>
								</div>
								<div class="form-field">
									<div class="form-switch-container">
										<label for="always_mobile_ui" class="form-switch-label">Always Use Mobile UI</label>
										<input name="ALWAYS_MOBILE_UI" class="form-check-input" type="checkbox" id="always_mobile_ui">
									</div>
									<div class="form-field-description">Force mobile UI for all devices</div>
								</div>
								<div class="form-field">
									<div class="form-switch-container">
										<label for="single_server_mode" class="form-switch-label">Single Server Mode</label>
										<input name="SINGLE_SERVER_MODE" class="form-check-input" type="checkbox" id="single_server_mode">
									</div>
									<div class="form-field-description">Enable single server mode</div>
								</div>
								<div class="form-field">
									<label for="cypht_modules" class="form-field-label">Cypht Modules</label>
									<input type="text" name="CYPHT_MODULES" id="cypht_modules" class="form-input" placeholder="core,contacts,local_contacts,feeds,imap,smtp" value="core,contacts,local_contacts,feeds,imap,smtp,account,idle_timer,calendar,themes,nux,developer,history,saved_searches,advanced_search,highlights,profiles,inline_message,imap_folders,keyboard_shortcuts,tags">
									<div class="form-field-description">Comma-separated list of enabled modules</div>
								</div>
								<div class="form-field">
									<div class="form-switch-container">
										<label for="fancy_login" class="form-switch-label">Fancy Login Page</label>
										<input name="FANCY_LOGIN" class="form-check-input" type="checkbox" id="fancy_login">
									</div>
									<div class="form-field-description">Enable fancy login page design</div>
								</div>
								<div class="form-field">
									<label for="api_login_key" class="form-field-label">API Login Key</label>
									<input type="text" name="API_LOGIN_KEY" id="api_login_key" class="form-input" placeholder="">
									<div class="form-field-description">API login key for authentication</div>
								</div>
								<div class="form-field">
									<label for="win_cacert_dir" class="form-field-label">Windows CA Certificate Directory</label>
									<input type="text" name="WIN_CACERT_DIR" id="win_cacert_dir" class="form-input" placeholder="Enter the path to the CA certificates for Windows" value="c:\php\extras\ssl\cacert.pem">
									<div class="form-field-description">Path to CA certificates for Windows (get from https://curl.se/ca/cacert.pem)</div>
								</div>
							</div>
						</div>

						<!-- Section Session -->
						<div class="config-content-item" id="session">
							<div class="cc-body-header">
								<div class="cc-body-header-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.513 19.487c2.512 2.392 5.503 1.435 6.7.466c.618-.501.897-.825 1.136-1.065c.837-.777.784-1.555.24-2.177c-.219-.249-1.616-1.591-2.956-2.967c-.694-.694-1.172-1.184-1.582-1.58c-.547-.546-1.026-1.172-1.744-1.154c-.658 0-1.136.58-1.735 1.179c-.688.688-1.196 1.555-1.375 2.333c-.539 2.273.299 3.888 1.316 4.965m0 0L2 21.999M19.487 4.515c-2.513-2.394-5.494-1.42-6.69-.45c-.62.502-.898.826-1.138 1.066c-.837.778-.784 1.556-.239 2.178c.078.09.31.32.635.644m7.432-3.438c1.017 1.077 1.866 2.71 1.327 4.985c-.18.778-.688 1.645-1.376 2.334c-.598.598-1.077 1.179-1.735 1.179c-.718.018-1.09-.502-1.639-1.048m3.423-7.45L22 2m-5.936 9.964c-.41-.395-.994-.993-1.688-1.687c-.858-.882-1.74-1.75-2.321-2.325m4.009 4.012l-1.562 1.524m-3.99-3.983l1.543-1.553" color="currentColor"/></svg>
									<span>Session</span>
								</div>
								<button type="button" class="cc-header-reset-btn" onclick="resetSection('session')">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.001 10c0 3.3 0 4.95 1.025 5.975S5.701 17 9.001 17s4.95 0 5.975-1.025S16 13.3 16 10s0-4.95-1.025-5.975S12.3 3 9 3S4.05 3 3.025 4.025S2.001 6.7 2.001 10M22 14.42l-1.11-1.346c-.591-.716-.887-1.074-1.254-1.074v1c0 3.771 0 5.657-1.171 6.828S15.408 21 11.636 21H11" color="currentColor"/></svg>
									Reset
								</button>
							</div>
							<div class="cc-body-content">
								<div class="form-field">
									<label for="session_type" class="form-field-label">Session Type</label>
									<select name="SESSION_TYPE" id="session_type" class="form-select">
										<option value="PHP">Standard PHP session handlers</option>
										<option value="DB">Custom database based sessions</option>
										<option value="MEM">Custom Memcached based sessions</option>
										<option value="REDIS">Custom Redis based sessions</option>
										<option value="custom">Create your own session class</option>
									</select>
									<div class="form-field-description">Choose how to handle user sessions</div>
								</div>
								<div class="form-field">
									<label for="session_class" class="form-field-label">Session Class</label>
									<input type="text" name="SESSION_CLASS" id="session_class" class="form-input" placeholder="">
									<div class="form-field-description">Custom session class name (if using custom session type)</div>
								</div>
								<div class="form-field">
									<div class="form-switch-container">
										<label for="allow_session_cache" class="form-switch-label">Allow Session Cache</label>
										<input name="ALLOW_SESSION_CACHE" class="form-check-input" type="checkbox" id="allow_session_cache">
									</div>
									<div class="form-field-description">Enable session caching</div>
								</div>
								<div class="form-field">
									<div class="form-switch-container">
										<label for="allow_long_session" class="form-switch-label">Allow Long Sessions</label>
										<input name="ALLOW_LONG_SESSION" class="form-check-input" type="checkbox" id="allow_long_session">
									</div>
									<div class="form-field-description">Allow extended session lifetime</div>
								</div>
								<div class="form-field">
									<label for="long_session_lifetime" class="form-field-label">Long Session Lifetime (days)</label>
									<input type="number" name="LONG_SESSION_LIFETIME" id="long_session_lifetime" class="form-input" placeholder="30" value="30">
									<div class="form-field-description">Lifetime for long sessions in days</div>
								</div>
							</div>
						</div>
						<!-- Section Authentification -->
						<div class="config-content-item" id="auth">
							<div class="cc-body-header">
								<div class="cc-body-header-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.513 19.487c2.512 2.392 5.503 1.435 6.7.466c.618-.501.897-.825 1.136-1.065c.837-.777.784-1.555.24-2.177c-.219-.249-1.616-1.591-2.956-2.967c-.694-.694-1.172-1.184-1.582-1.58c-.547-.546-1.026-1.172-1.744-1.154c-.658 0-1.136.58-1.735 1.179c-.688.688-1.196 1.555-1.375 2.333c-.539 2.273.299 3.888 1.316 4.965m0 0L2 21.999M19.487 4.515c-2.513-2.394-5.494-1.42-6.69-.45c-.62.502-.898.826-1.138 1.066c-.837.778-.784 1.556-.239 2.178c.078.09.31.32.635.644m7.432-3.438c1.017 1.077 1.866 2.71 1.327 4.985c-.18.778-.688 1.645-1.376 2.334c-.598.598-1.077 1.179-1.735 1.179c-.718.018-1.09-.502-1.639-1.048m3.423-7.45L22 2m-5.936 9.964c-.41-.395-.994-.993-1.688-1.687c-.858-.882-1.74-1.75-2.321-2.325m4.009 4.012l-1.562 1.524m-3.99-3.983l1.543-1.553" color="currentColor"/></svg>
									<span>Authentication</span>
								</div>
								<button type="button" class="cc-header-reset-btn" onclick="resetSection('auth')">
									<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.001 10c0 3.3 0 4.95 1.025 5.975S5.701 17 9.001 17s4.95 0 5.975-1.025S16 13.3 16 10s0-4.95-1.025-5.975S12.3 3 9 3S4.05 3 3.025 4.025S2.001 6.7 2.001 10M22 14.42l-1.11-1.346c-.591-.716-.887-1.074-1.254-1.074v1c0 3.771 0 5.657-1.171 6.828S15.408 21 11.636 21H11" color="currentColor"/></svg>
									Reset
								</button>
							</div>
							<div class="cc-body-content">
								<div class="form-field">
									<label for="auth_type" class="form-field-label">Authentication Type</label>
									<select name="AUTH_TYPE" id="auth_type" class="form-select">
										<option value="DB">Authenticate against the database</option>
										<option value="LDAP">Authenticate against an LDAP server</option>
										<option value="IMAP">Authenticate using an IMAP server</option>
										<option value="dynamic">Let the user choose from a list</option>
										<option value="custom">Custom authentication class</option>
									</select>
									<div class="form-field-description">Select the authentication method for your application</div>
								</div>

								<div class="form-field">
									<label for="auth_class" class="form-field-label">Authentication Class</label>
									<input type="text" name="AUTH_CLASS" id="auth_class" class="form-input" placeholder="">
									<div class="form-field-description">Custom authentication class name (if using custom auth type)</div>
								</div>

								<!-- LDAP Configuration -->
								<div class="form-field-group">
									<div class="form-field">
