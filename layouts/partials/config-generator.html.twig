								<span>Session</span>
							</div>
							<button type="button" class="cc-header-reset-btn" onclick="resetSection('session')">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24"><!-- Icon from Huge Icons by Hugeicons - undefined --><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.001 10c0 3.3 0 4.95 1.025 5.975S5.701 17 9.001 17s4.95 0 5.975-1.025S16 13.3 16 10s0-4.95-1.025-5.975S12.3 3 9 3S4.05 3 3.025 4.025S2.001 6.7 2.001 10M22 14.42l-1.11-1.346c-.591-.716-.887-1.074-1.254-1.074v1c0 3.771 0 5.657-1.171 6.828S15.408 21 11.636 21H11" color="currentColor"/></svg>
								Reset
							</button>
						</div>
						<div class="cc-body-content">
							<div class="form-field">
								<label for="session_type" class="form-field-label">Session Type</label>
								<select name="SESSION_TYPE" id="session_type" class="form-select">
									<option value="PHP">Standard PHP session handlers</option>
									<option value="DB">Custom database based sessions</option>
									<option value="MEM">Custom Memcached based sessions</option>
									<option value="REDIS">Custom Redis based sessions</option>
									<option value="custom">Create your own session class</option>
								</select>
								<div class="form-field-description">Choose how to handle user sessions</div>
							</div>
						</div>
					</div>

					<!-- Section Authentification -->
