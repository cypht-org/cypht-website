{# Template #}
<section>
	<div class="config-gen-container">
		<div class="config-content">
			<div class="config-left">
				<nav>
					<div class="config-left-header">
						<div class="">
							<h5>Config menu</h5>
							<p>Choose a config to generate</p>
						</div>
						<div class="cfh-version">
							<span>Version</span>
							<select class="form-select" id="floatingSelect" aria-label="Floating label select example">
								<option value="0">v1.4.x</option>
								<option value="1">v2.x.x</option>
							</select>
						</div>
					</div>
					<div class="config-generator-list-container">
						<ul class="config-generator-list">
							{% for item in config_menu %}

								{% if item.children is defined and item.children|length > 1 %}
									<li class="position-relative cg-menu-group">
										<a href=" {{item.href}} " class=" config-generator-link text-capitalize " data-id=" {{item.id}} ">{{item.title}}
										</a>
										<div class="position-relative ">
											<div class="cc-line-top"></div>
											<ul class="group-list">
												{% for child in item.children %}
													<li class="position-relative">
														<a href="{{child.href}}" class=" {{child.id == 0 ? 'config-active' : ''}}" data-id="{{child.id}}">{{child.title}}</a>
													</li>
												{% endfor %}
											</ul>
											<div class="cc-line-bottom"></div>
										</div>
									</li>
								{% else %}
									<li class="position-relative cg-menu-alone">
										<a href="{{item.href}}" class="config-generator-link text-capitalize {{item.id == 0 ? 'config-active' : ''}}" data-id="{{item.id}}">{{item.title}}</a>
									</li>
								{% endif %}
							{% endfor %}
						</ul>
					</div>
				</nav>
			</div>
			<div
				class="config-center">
				{# App config #}
				<div class="config-content-item">
					<div class="config-content-item-header">
						<div class="cc-item-top">
							<div class="cc-item-top-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24">
									<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M7 21h10"/><rect width="20" height="14" x="2" y="3" rx="2"/></g>
								</svg>
							</div>
							<div class="cc-item-top-text">
								<h5>App Config</h5>
								<p>Configure your Cypht application's core settings. Customize the basic behavior, display preferences, and essential features for an optimal user experience.</p>
							</div>
						</div>
					</div>
					<!-- Section Session -->
					<div class="config-content-item" id="session">
						<div class="cc-body-header">
							<div class="cc-body-header-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24">
									<g fill="none" stroke="currentColor" stroke-width="1.5">
										<path stroke-linejoin="round" d="M11.5 16h1a1 1 0 0 0 1-1v-1.401A2.999 2.999 0 0 0 12 8a3 3 0 0 0-1.5 5.599V15a1 1 0 0 0 1 1Z"/>
										<path stroke-linecap="round" d="M3 10.417c0-3.198 0-4.797.378-5.335c.377-.537 1.88-1.052 4.887-2.081l.573-.196C10.405 2.268 11.188 2 12 2c.811 0 1.595.268 3.162.805l.573.196c3.007 1.029 4.51 1.544 4.887 2.081C21 5.62 21 7.22 21 10.417v1.574c0 2.505-.837 4.437-2 5.913M3.193 14c.857 4.298 4.383 6.513 6.706 7.527c.721.315 1.082.473 2.101.473c1.02 0 1.38-.158 2.101-.473c.579-.252 1.231-.58 1.899-.994"/>
									</g>
								</svg>
								<span>Session</span>
							</div>
							<button type="button" class="cc-header-reset-btn" onclick="resetSection('session')">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
									<path d="M21 3v5h-5"/>
									<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
									<path d="M3 21v-5h5"/>
								</svg>
								Reset
							</button>
						</div>
						<div class="cc-body-content">
							<div class="form-field">
								<label for="session_type" class="form-field-label">Session Type</label>
								<select name="SESSION_TYPE" id="session_type" class="form-select">
									<option value="PHP">Standard PHP session handlers</option>
									<option value="DB">Custom database based sessions</option>
									<option value="MEM">Custom Memcached based sessions</option>
									<option value="REDIS">Custom Redis based sessions</option>
									<option value="custom">Create your own session class</option>
								</select>
								<div class="form-field-description">Choose how to handle user sessions</div>
							</div>
						</div>
					</div>

					<!-- Section Authentification -->
					<div class="config-content-item" id="auth">
						<div class="cc-body-header">
							<div class="cc-body-header-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24">
									<g fill="none" stroke="currentColor" stroke-width="1.5">
										<path stroke-linejoin="round" d="M11.5 16h1a1 1 0 0 0 1-1v-1.401A2.999 2.999 0 0 0 12 8a3 3 0 0 0-1.5 5.599V15a1 1 0 0 0 1 1Z"/>
										<path stroke-linecap="round" d="M3 10.417c0-3.198 0-4.797.378-5.335c.377-.537 1.88-1.052 4.887-2.081l.573-.196C10.405 2.268 11.188 2 12 2c.811 0 1.595.268 3.162.805l.573.196c3.007 1.029 4.51 1.544 4.887 2.081C21 5.62 21 7.22 21 10.417v1.574c0 2.505-.837 4.437-2 5.913M3.193 14c.857 4.298 4.383 6.513 6.706 7.527c.721.315 1.082.473 2.101.473c1.02 0 1.38-.158 2.101-.473c.579-.252 1.231-.58 1.899-.994"/>
									</g>
								</svg>
								<span>Authentication</span>
							</div>
							<button type="button" class="cc-header-reset-btn" onclick="resetSection('auth')">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
									<path d="M21 3v5h-5"/>
									<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
									<path d="M3 21v-5h5"/>
								</svg>
								Reset
							</button>
						</div>
						<div class="cc-body-content">
							<div class="form-field">
								<label for="auth_type" class="form-field-label">Authentication Type</label>
								<select name="AUTH_TYPE" id="auth_type" class="form-select">
									<option value="DB">Authenticate against the database</option>
									<option value="LDAP">Authenticate against an LDAP server</option>
									<option value="IMAP">Authenticate using an IMAP server</option>
									<option value="dynamic">Let the user choose from a list</option>
									<option value="custom">Custom authentication class</option>
								</select>
								<div class="form-field-description">Select the authentication method for your application</div>
							</div>

							<!-- LDAP Configuration -->
							<div class="form-field-group">
								<div class="form-field">
									<label for="ldap_auth_server" class="form-field-label">LDAP Server</label>
									<input type="text" name="LDAP_AUTH_SERVER" id="ldap_auth_server" class="form-input" placeholder="localhost">
									<div class="form-field-description">LDAP server hostname or IP address</div>
								</div>
								<div class="form-field">
									<label for="ldap_auth_port" class="form-field-label">LDAP Port</label>
									<input type="number" name="LDAP_AUTH_PORT" id="ldap_auth_port" class="form-input" value="389" min="1" max="65535">
									<div class="form-field-description">LDAP server port (default: 389)</div>
								</div>
							</div>

							<div class="form-field">
								<div class="form-switch-container">
									<label for="ldap_auth_tls" class="form-switch-label">Enable TLS for LDAP</label>
									<input class="form-check-input" type="checkbox" id="ldap_auth_tls">
								</div>
								<div class="form-field-description">Enable secure connection to LDAP server</div>
							</div>

							<!-- IMAP Configuration -->
							<div class="form-field-group">
								<div class="form-field">
									<label for="imap_auth_server" class="form-field-label">IMAP Server</label>
									<input type="text" name="IMAP_AUTH_SERVER" id="imap_auth_server" class="form-input" placeholder="imap.example.com">
									<div class="form-field-description">IMAP server hostname or IP address</div>
								</div>
								<div class="form-field">
									<label for="imap_auth_port" class="form-field-label">IMAP Port</label>
									<input type="number" name="IMAP_AUTH_PORT" id="imap_auth_port" class="form-input" value="993" min="1" max="65535">
									<div class="form-field-description">IMAP server port (default: 993)</div>
								</div>
							</div>

							<div class="form-field">
								<div class="form-switch-container">
									<label for="imap_auth_tls" class="form-switch-label">Enable TLS for IMAP</label>
									<input class="form-check-input" type="checkbox" id="imap_auth_tls">
								</div>
								<div class="form-field-description">Enable secure connection to IMAP server</div>
							</div>
						</div>
					</div>

					<!-- Section Utilisateur -->
					<div class="config-content-item" id="user">
						<div class="cc-body-header">
							<div class="cc-body-header-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24">
									<g fill="none" stroke="currentColor" stroke-width="1.5">
										<path stroke-linejoin="round" d="M11.5 16h1a1 1 0 0 0 1-1v-1.401A2.999 2.999 0 0 0 12 8a3 3 0 0 0-1.5 5.599V15a1 1 0 0 0 1 1Z"/>
										<path stroke-linecap="round" d="M3 10.417c0-3.198 0-4.797.378-5.335c.377-.537 1.88-1.052 4.887-2.081l.573-.196C10.405 2.268 11.188 2 12 2c.811 0 1.595.268 3.162.805l.573.196c3.007 1.029 4.51 1.544 4.887 2.081C21 5.62 21 7.22 21 10.417v1.574c0 2.505-.837 4.437-2 5.913M3.193 14c.857 4.298 4.383 6.513 6.706 7.527c.721.315 1.082.473 2.101.473c1.02 0 1.38-.158 2.101-.473c.579-.252 1.231-.58 1.899-.994"/>
									</g>
								</svg>
								<span>User</span>
							</div>
							<button type="button" class="cc-header-reset-btn" onclick="resetSection('user')">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
									<path d="M21 3v5h-5"/>
									<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
									<path d="M3 21v-5h5"/>
								</svg>
								Reset
							</button>
						</div>
						<div class="cc-body-content">
							<div class="form-field">
								<label for="user_config_type" class="form-field-label">User Configuration Type</label>
								<select name="USER_CONFIG_TYPE" id="user_config_type" class="form-select">
									<option value="file">Store user settings in the filesystem</option>
									<option value="DB">Store user settings in a database</option>
									<option value="custom">Custom user settings storage</option>
								</select>
								<div class="form-field-description">Choose how to store user configuration data</div>
							</div>
							<div class="form-field">
								<label for="user_settings_dir" class="form-field-label">User Settings Directory</label>
								<input type="text" name="USER_SETTINGS_DIR" id="user_settings_dir" class="form-input" placeholder="/path/to/settings">
								<div class="form-field-description">Directory path for storing user settings (file mode only)</div>
							</div>
						</div>
					</div>
					<!-- Security -->
					<div class="config-content-item" id="security">
						<div class="cc-body-header">
							<div class="cc-body-header-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24">
									<g fill="none" stroke="currentColor" stroke-width="1.5">
										<path stroke-linejoin="round" d="M11.5 16h1a1 1 0 0 0 1-1v-1.401A2.999 2.999 0 0 0 12 8a3 3 0 0 0-1.5 5.599V15a1 1 0 0 0 1 1Z"/>
										<path stroke-linecap="round" d="M3 10.417c0-3.198 0-4.797.378-5.335c.377-.537 1.88-1.052 4.887-2.081l.573-.196C10.405 2.268 11.188 2 12 2c.811 0 1.595.268 3.162.805l.573.196c3.007 1.029 4.51 1.544 4.887 2.081C21 5.62 21 7.22 21 10.417v1.574c0 2.505-.837 4.437-2 5.913M3.193 14c.857 4.298 4.383 6.513 6.706 7.527c.721.315 1.082.473 2.101.473c1.02 0 1.38-.158 2.101-.473c.579-.252 1.231-.58 1.899-.994"/>
									</g>
								</svg>
								<span>Security</span>
							</div>
							<button type="button" class="cc-header-reset-btn" onclick="resetSection('security')">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
									<path d="M21 3v5h-5"/>
									<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
									<path d="M3 21v-5h5"/>
								</svg>
								Reset
							</button>
						</div>
						<div class="cc-body-content">
							<div class="form-field">
								<div class="form-switch-container">
									<label for="disable_origin_check" class="form-switch-label">Disable Origin Check</label>
									<input class="form-check-input" type="checkbox" id="disable_origin_check">
								</div>
								<div class="form-field-description">Disable origin check for enhanced security (recommended)</div>
							</div>

							<div class="form-field-group">
								<div class="form-field">
									<label for="cookie_domain" class="form-field-label">Cookie Domain</label>
									<input type="text" name="COOKIE_DOMAIN" id="cookie_domain" class="form-input" placeholder="example.com">
									<div class="form-field-description">Domain for application cookies</div>
								</div>
								<div class="form-field">
									<label for="cookie_path" class="form-field-label">Cookie Path</label>
									<input type="text" name="COOKIE_PATH" id="cookie_path" class="form-input" placeholder="/" value="/">
									<div class="form-field-description">Path for application cookies</div>
								</div>
							</div>

							<div class="form-field">
								<div class="form-switch-container">
									<label for="encrypt_ajax_request" class="form-switch-label">Encrypt AJAX Requests</label>
									<input class="form-check-input" type="checkbox" id="encrypt_ajax_request">
								</div>
								<div class="form-field-description">Encrypt all AJAX requests for enhanced security</div>
							</div>

							<div class="form-field">
								<div class="form-switch-container">
									<label for="encrypt_local_storage" class="form-switch-label">Encrypt Local Storage</label>
									<input class="form-check-input" type="checkbox" id="encrypt_local_storage">
								</div>
								<div class="form-field-description">Encrypt data stored in browser local storage</div>
							</div>
						</div>
					</div>
				</div>
				{# Database config #}
				<div class="config-content-item">
					<div class="config-content-item-header">
						<div class="cc-item-top">
							<div class="cc-item-top-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24">
									<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 12 2.84M21 5v3m0 4l-3 5h4l-3 5"/><path d="M3 12a9 3 0 0 0 11.59 2.87"/></g>
								</svg>
							</div>
							<div class="cc-item-top-text">
								<h5>Database Config</h5>
								<p>Configure your Cypht application's database settings. Set up the database connection parameters to ensure smooth data management and retrieval.</p>
							</div>
						</div>
					</div>

					<div class="config-content-item" id="database">
						<div class="cc-body-header">
							<div class="cc-body-header-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewbox="0 0 24 24">
									<g fill="none" stroke="currentColor" stroke-width="1.5">
										<path stroke-linejoin="round" d="M11.5 16h1a1 1 0 0 0 1-1v-1.401A2.999 2.999 0 0 0 12 8a3 3 0 0 0-1.5 5.599V15a1 1 0 0 0 1 1Z"/>
										<path stroke-linecap="round" d="M3 10.417c0-3.198 0-4.797.378-5.335c.377-.537 1.88-1.052 4.887-2.081l.573-.196C10.405 2.268 11.188 2 12 2c.811 0 1.595.268 3.162.805l.573.196c3.007 1.029 4.51 1.544 4.887 2.081C21 5.62 21 7.22 21 10.417v1.574c0 2.505-.837 4.437-2 5.913M3.193 14c.857 4.298 4.383 6.513 6.706 7.527c.721.315 1.082.473 2.101.473c1.02 0 1.38-.158 2.101-.473c.579-.252 1.231-.58 1.899-.994"/>
									</g>
								</svg>
								<span>Database</span>
							</div>
							<button type="button" class="cc-header-reset-btn" onclick="resetSection('database')">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
									<path d="M21 3v5h-5"/>
									<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
									<path d="M3 21v-5h5"/>
								</svg>
								Reset
							</button>
						</div>
						<div
							class="cc-body-content">
							<!-- Connection Type -->
							<div class="form-field">
								<label for="db_connection_type" class="form-field-label">Connection Type</label>
								<select name="DB_CONNECTION_TYPE" id="db_connection_type" class="form-select">
									<option value="tcp">TCP/IP</option>
									<option value="socket">Socket</option>
								</select>
								<div class="form-field-description">Choose how to connect to the database</div>
							</div>

							<!-- TCP/IP Fields -->
							<div id="tcp-fields">
								<div class="form-field-group">
									<div class="form-field">
										<label for="db_host" class="form-field-label">Database Host</label>
										<input type="text" name="DB_HOST" id="db_host" class="form-input" placeholder="localhost" value="localhost">
										<div class="form-field-description">Database server hostname or IP address</div>
									</div>
									<div class="form-field">
